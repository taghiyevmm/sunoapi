# Suno API Key from sunoapi.org
# Get your API key at: https://sunoapi.org
SUNOAPI_KEY=your_api_key_here

# API Key for authenticating client requests
# Generate a random 64-character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, all API requests will be allowed (dev mode)
CLIENT_API_KEY=
